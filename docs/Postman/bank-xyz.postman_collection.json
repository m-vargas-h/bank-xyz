    {
      "name": "4. Saga: retiro ATM",
      "item": [
        {
          "name": "4.1 Saldo antes del retiro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bffUrl}}/atm/saldo/{{cuentaOk}}",
              "host": [
