    "name": "Banco XYZ - Batería de pruebas",
    "description": "Pruebas de todos los componentes. Usar el environment 'Banco XYZ - Local'. Desactivar 'SSL certificate verification' (certificado autofirmado del BFF). Orden: 0, 1, 2, 3, 4, 5, 6, 7. La carpeta 8 es manual.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Autenticación OAuth2",
      "item": [
        {
          "name": "Obtener token (client_credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/oauth2/token",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "oauth2",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "scope",
                  "value": "cuentas.read transacciones.read clientes.read transacciones.write"
                }
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientSecret}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Devuelve access_token Bearer\", () => { pm.expect(j.access_token).to.be.a(\"string\"); pm.expect(j.token_type).to.eql(\"Bearer\"); });",
                  "pm.collectionVariables.set(\"token\", j.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Microservicio sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{msCuentasUrl}}/api/cuentas/101/saldo",
