              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"saldoAntes\", pm.response.json().datos.saldo);",
                  "console.log(\"Saldo antes:\", pm.collectionVariables.get(\"saldoAntes\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Retiro válido (202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bffUrl}}/atm/retiro",
              "host": [
                "{{bffUrl}}"
              ],
              "path": [
                "atm",
                "retiro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"cuentaId\": {{cuentaOk}}, \"monto\": {{montoOk}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 202\", () => pm.response.to.have.status(202));",
                  "const j = pm.response.json();",
                  "pm.test(\"Queda PENDIENTE y devuelve id\", () => { pm.expect(j.datos.estado).to.eql(\"PENDIENTE\"); pm.expect(j.datos.id).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"idOk\", j.datos.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Estado: COMPLETADA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bffUrl}}/atm/retiro/{{idOk}}",
              "host": [
                "{{bffUrl}}"
              ],
              "path": [
                "atm",
                "retiro",
                "{{idOk}}"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// la Saga es asíncrona: espera 2 s antes de consultar",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Saga completada\", () => pm.expect(pm.response.json().datos.estado).to.eql(\"COMPLETADA\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 Saldo después (descontado)",
