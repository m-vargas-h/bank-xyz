  "item": [
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Ejecutar Jobs",
          "item": [
            {
              "name": "Job 1 - Daily Transaction Report",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/jobs/daily-transaction?threads=4&chunkSize=10",
                  "host": ["{{base_url}}"],
                  "path": ["jobs", "daily-transaction"],
                  "query": [
                    { "key": "threads", "value": "4" },
                    { "key": "chunkSize", "value": "10" }
                  ]
                }
              }
            },
            {
              "name": "Job 2 - Monthly Interest",
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{base_url}}/jobs/monthly-interest?threads=4&chunkSize=10",
